{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "vite build",
  "outputDirectory": "dist/public",
  "functions": {
    "api/**/*.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/manus-storage/(.*)", "destination": "/api/manus-storage/$1" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
